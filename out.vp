-	case VIRTCHNL_STATUS_ERR_INVALID_VF_ID:
-		return "VIRTCHNL_STATUS_ERR_INVALID_VF_ID";
-	case VIRTCHNL_STATUS_ERR_ADMIN_QUEUE_ERROR:
-		return "VIRTCHNL_STATUS_ERR_ADMIN_QUEUE_ERROR";

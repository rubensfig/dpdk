 	nr_tx = rte_eth_tx_burst(tx_port, tx_queue, li->pkts, cnt);
 	li->tx_pkts  += nr_tx;
 	li->tx_drops += cnt - nr_tx;
@@ -2039,11 +2053,13 @@ init_port(void)

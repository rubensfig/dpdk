diff --git a/examples/qos_sched/app_thread.c b/examples/qos_sched/app_thread.c
index 5b8e932a19..1c1a86902c 100644
--- a/examples/qos_sched/app_thread.c
+++ b/examples/qos_sched/app_thread.c
@@ -72,6 +72,47 @@ static inline int get_pkt_sched(struct rte_mbuf *m, uint32_t *subport, uint32_t
 	return 0;
 }
 
+#define BP_ON_THRESHOLD 5   // number of drops to activate
+#define BP_OFF_THRESHOLD 0  // number of drops to deactivate
+/**
+ * Update backpressure state based on packet drop rate
+ * 
+ * This function monitors the TX drop rate and activates/deactivates
+ * backpressure to prevent overwhelming the NIC TX capacity.
+ */
+static inline void
+update_backpressure_state(uint16_t port)
+{
+	struct rte_port_statistics *stats = &port_statistics[port];
+	uint64_t now = rte_get_tsc_cycles();
+	uint64_t elapsed = now - stats->last_check_tsc;
+	uint64_t check_interval = stats->tsc_hz / 10000; // 100us
+	//
+	if (elapsed < check_interval)
+		return;
+	
+	stats->last_check_tsc = now;
+	
+	for (int tc = 0; tc < N_TC; tc++) {
+		uint64_t dropped = tc_stats.dropped[tc];
+		uint64_t last = stats->last_dropped[tc];
+		uint64_t new_drops = (dropped >= last) ? (dropped - last) : dropped; // handle wrap
+		stats->last_dropped[tc] = dropped;
+		
+		// Hysteresis: only turn on if above threshold, only turn off if at or below threshold
+		if (new_drops > 0)
+			backpressure_active[tc] = true;
+		else if (new_drops <= 0)
+			backpressure_active[tc] = false;
+		
+		// Optional: minimal logging for debug every 1000 checks
+		static int dbg_counter = 0;
+		dbg_counter++;
+		if (dbg_counter % 1000 == 0)
+			printf("Port %d TC %d BP: %s\n", port, tc, backpressure_active[tc] ? "ACTIVE" : "INACTIVE");
+	}
+}
+

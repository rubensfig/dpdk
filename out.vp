  */
 #define	MC_CMD_ERR_TRANSPORT_NOPROXY 0x100d
@@ -376,7 +379,7 @@
  * sub-variant switching.
  */
 #define	MC_CMD_ERR_FILTERS_PRESENT 0x1014
-/* enum: The clock whose frequency you've attempted to set set doesn't exist on

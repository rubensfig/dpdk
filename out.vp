@@ -467,6 +502,20 @@ mana_rx_burst(void *dpdk_rxq, struct rte_mbuf **pkts, uint16_t pkts_n)
 		}
 
 		wqe_posted++;
+		if (pkt_received == pkts_n)
+			break;
+	}
+
+	rxq->backlog_idx = pkt_idx;
+	rxq->comp_buf_idx = i;

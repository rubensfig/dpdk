 #include <idpf_common_logs.h>
 
+#define IDPF_DEV_ID_SRIOV	0x145C
+
 #define IDPF_RSS_KEY_LEN	52
 
 #define IDPF_CTLQ_ID		-1
diff --git a/drivers/net/idpf/idpf_ethdev.c b/drivers/net/idpf/idpf_ethdev.c

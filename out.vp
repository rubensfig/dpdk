diff --git a/examples/qos_sched/main.h b/examples/qos_sched/main.h
index c20eb3db81..ff757dd4e9 100644
--- a/examples/qos_sched/main.h
+++ b/examples/qos_sched/main.h
@@ -58,6 +58,7 @@ extern "C" {
 #define APP_QAVG_PERIOD 100
 
 #define N_TX_QUEUES 2
+#define N_TC 2
 
 struct thread_stat
 {
@@ -65,6 +66,34 @@ struct thread_stat
 	uint64_t nb_drop;
 };
 
+/* Backpressure tuning parameters */
+#define BP_THRESHOLD_RATIO 0.005    /* Activate at 5% drop rate */
+#define BP_RECOVERY_RATIO  0.01    /* Recover at 1% drop rate */
+
+/* Global per-TC drop counters (aggregated across all ports) */
+struct tc_statistics {
+	uint64_t dropped[N_TC];
+} __rte_cache_aligned;
+
+extern struct tc_statistics tc_stats;
+/* Per-port statistics struct for backpressure mechanism */
+struct __rte_cache_aligned rte_port_statistics {
+	uint64_t last_dropped[N_TC];   // last dropped count per TC
+	uint64_t last_check_tsc;
+	uint64_t tsc_hz;
+	uint8_t bp_active_counter[N_TC]; // for optional extended hysteresis
+};
+
+/* Callback context with TC info */
+struct tx_callback_ctx {
+	uint16_t portid;
+	uint8_t tc_id;
+};
+
+extern struct tx_callback_ctx tx_ctx[RTE_MAX_ETHPORTS][N_TX_QUEUES];
+
+extern struct rte_port_statistics port_statistics[RTE_MAX_ETHPORTS];
+extern bool backpressure_active[N_TC];  /* 1 if backpressure is currently active */
 
 struct thread_conf
 {

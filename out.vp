-			__le32 dma_addr_lo;
+			uint32_t dma_addr_lo;
 		} __rte_packed fld;
 
 		/* RX descriptor */
 		struct {
-			__le16 data_len;
+			uint16_t data_len;
 			uint8_t reserved;
 			uint8_t meta_len_dd;
 

-static inline const char *virtchnl_stat_str(enum virtchnl_status_code v_status)
-{
-	switch (v_status) {
-	case VIRTCHNL_STATUS_SUCCESS:
-		return "VIRTCHNL_STATUS_SUCCESS";
-	case VIRTCHNL_STATUS_ERR_PARAM:

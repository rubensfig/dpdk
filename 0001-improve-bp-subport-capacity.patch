+/**
+ * Backpressure mechanism tuning parameters
+ *
+ * BP_CHECK_INTERVAL_US: How often to check drop rates and adjust capacity
+ * BP_THRESHOLD_RATE: Drop ratio threshold to trigger backpressure
+ *                    (e.g., 0.01 = 1% drops trigger BP)
+ * BP_RECOVERY_RATE: Drop ratio threshold to allow capacity recovery
+ * BP_CAPACITY_MIN_PCT: Minimum allowed subport capacity during BP
+ * BP_CAPACITY_STEP_PCT: How much to reduce capacity per cycle
+ * BP_RECOVERY_STEP_PCT: How much to recover capacity per cycle
+ */
+#define BP_CHECK_INTERVAL_US  100
+#define BP_THRESHOLD_RATE     0.01    /* 1% drop rate */
+#define BP_RECOVERY_RATE      0.15
+#define BP_CAPACITY_MIN_PCT   10      /* 10% of configured capacity */
+#define BP_CAPACITY_STEP_PCT  5       /* 5% reduction per cycle */
+#define BP_RECOVERY_STEP_PCT  2       /* 2% recovery per cycle */
+
+/**
+ * Global per-TC drop counters
+ * 
+ * Aggregated across all ports for monitoring total system drops.
+ * Updated atomically by TX callback.
+ */
+struct tc_statistics {
+	uint64_t dropped[N_TC];  /* Per-TC drop count */
+} __rte_cache_aligned;
+
+extern struct tc_statistics tc_stats;
+
+/**
+ * Per-port statistics for backpressure-driven capacity control
+ *
+ * Tracks drop patterns, maintains per-TC capacity quotas, and manages
+ * state transitions in the backpressure control loop.
+ */
+struct rte_port_statistics {
+	/* Drop tracking from NIC TX buffer */
+	uint64_t last_dropped[N_TC];   /* Previous cumulative drop count per TC */
+	uint64_t dropped[N_TC];        /* Atomically updated drop count per TC */
+	
+	/* Traffic statistics */
+	uint64_t last_tx[N_TC];        /* Previous TX count per TC */
+	uint64_t tx[N_TC];             /* Current TX count per TC */
+	uint64_t last_rx;              /* Previous RX count */
+	uint64_t rx;                   /* Current RX count */
+	
+	/* Timing and frequency */
+	uint64_t last_check_tsc;       /* TSC of last BP state update */
+	uint64_t tsc_hz;               /* TSC frequency for unit conversion */
+	
+	/* Backpressure state per TC */
+	bool bp_active[N_TC];          /* True if BP currently active for this TC */
+	uint32_t subport_capacity[N_TC]; /* Current capacity quota (0-100 percent) */
+	
+	/* Drop event timing */
+	uint64_t last_drop_tsc[N_TC];  /* TSC of last observed drop for this TC */
+	
+} __rte_cache_aligned;
+
+/**
+ * TX callback context for tracking dropped packets per TC
+ */
+struct tx_callback_ctx {
+	uint16_t portid;  /* Port ID for logging */
+	uint8_t tc_id;    /* Traffic class ID (maps to queue) */
+};
+
+extern struct tx_callback_ctx tx_ctx[RTE_MAX_ETHPORTS][N_TX_QUEUES];
+extern struct rte_port_statistics port_statistics[RTE_MAX_ETHPORTS];
+
 

commit d131422280a5127f7151ee486c67376f7ee2b931
Author: Rubens Figueiredo <rubens.figueiredo@bisdn.de>
Date:   Fri Nov 29 11:31:13 2024 +0100

    virtchnl: expand the list of virtchnl ops pmdlink: add files
    
    Signed-off-by: Rubens Figueiredo <rubens.figueiredo@bisdn.de>
    
    Signed-off-by: Rubens Figueiredo <rubens.figueiredo@bisdn.de>

diff --git a/drivers/net/iavf/iavf_pmdlink.c b/drivers/net/iavf/iavf_pmdlink.c
new file mode 100644
index 0000000000..867ef57452
--- /dev/null
+++ b/drivers/net/iavf/iavf_pmdlink.c
@@ -0,0 +1,39 @@
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <unistd.h>
+#include <inttypes.h>
+#include <sys/queue.h>
+
+#include <rte_string_fns.h>
+#include <rte_memzone.h>
+#include <rte_mbuf.h>
+#include <rte_malloc.h>
+#include <rte_ether.h>
+#include <ethdev_driver.h>
+#include <rte_tcp.h>
+#include <rte_sctp.h>
+#include <rte_udp.h>
+#include <rte_ip.h>
+#include <rte_net.h>
+#include <rte_vect.h>
+#include <rte_vxlan.h>
+#include <rte_gtp.h>
+#include <rte_geneve.h>
+
+#include "iavf.h"
+#include "iavf_pmdlink.h"
+
+
+int iavf_pmdlink_send_vf_msg(struct rte_eth_dev *dev, struct vf_msg_command *cmd) {
+	
+	struct iavf_adapter *ad = IAVF_DEV_PRIVATE_TO_ADAPTER(dev->data->dev_private);
+
+	iavf_vchnl_send_vf_msg(ad, cmd);
+
+        return 0;
+}
diff --git a/drivers/net/iavf/iavf_pmdlink.h b/drivers/net/iavf/iavf_pmdlink.h
new file mode 100644
index 0000000000..b14fb760e3
--- /dev/null
+++ b/drivers/net/iavf/iavf_pmdlink.h
@@ -0,0 +1,6 @@
+#ifndef _IAVF_PMDLINK_H_
+#define _IAVF_PMDLINK_H_
+
+int iavf_pmdlink_send_vf_msg(struct rte_eth_dev *dev, struct vf_msg_command *cmd);
+
+#endif /* _IAVF_PMDLINK_H_ */


+/**
+ * initialize_port_statistics - Initialize per-port backpressure tracking
+ *
+ * Sets up the statistics structure for backpressure-driven capacity control.
+ * Initializes capacity quotas to 100% and sets up timing baseline.
+ */
+static void
+initialize_port_statistics(uint16_t port)
+{
+	struct rte_port_statistics *stats = &port_statistics[port];
+	uint64_t hz = rte_get_tsc_hz();
+	
+	/* Initialize drop tracking */
+	for (int tc = 0; tc < N_TC; tc++) {
+		stats->dropped[tc] = 0;
+		stats->last_dropped[tc] = 0;
+		stats->tx[tc] = 0;
+		stats->last_tx[tc] = 0;
+		
+		/* Start at full capacity */
+		stats->subport_capacity[tc] = 100;
+		
+		/* BP inactive by default */
+		stats->bp_active[tc] = false;
+		stats->last_drop_tsc[tc] = 0;
+	}
+	
+	/* Initialize RX tracking */
+	stats->rx = 0;
+	stats->last_rx = 0;
+	
+	/* Set timing baseline */
+	stats->tsc_hz = hz;
+	stats->last_check_tsc = rte_get_tsc_cycles();
+	
+	RTE_LOG(INFO, APP,
+		"Initialized backpressure stats for port %u (TSC_HZ=%lu, "
+		"Check interval=%uus, Threshold=%.2f%%, Recovery=%uus)\n",
+		port, hz, BP_CHECK_INTERVAL_US, BP_THRESHOLD_RATE * 100,
+		BP_RECOVERY_TIME_US);
+}
+
 int
 app_port_init(uint16_t port, struct rte_mempool *mp)
 {
@@ -291,6 +338,11 @@ app_port_init(uint16_t port, struct rte_mempool *mp)
 		return ret;
 	}
 
+	/* Initialize backpressure tracking structure */
+	if (port < RTE_MAX_ETHPORTS) {
+		initialize_port_statistics(port);
+	}
+
 	printf("done\n");
 	return 0;
 }

-		return -1;
+	ret = eth_dev_parse_port_params(params, &port_id, &end_param, false);
+	if (ret < 0)
+		return ret;
 
 	ret = rte_eth_link_get_nowait(port_id, &link);
 	if (ret < 0)
@@ -247,19 +257,14 @@ eth_dev_handle_port_info(const char *cmd __rte_unused,

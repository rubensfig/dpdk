+/**
+ * Update backpressure state based on packet drop rate
+ * 
+ * This function monitors the TX drop rate and activates/deactivates
+ * backpressure to prevent overwhelming the NIC TX capacity.
+ */
+static inline void
+update_backpressure_state(uint16_t port)
+{
+	struct rte_port_statistics *stats = &port_statistics[port];
+	uint64_t now = rte_get_tsc_cycles();
+	uint64_t elapsed = now - stats->last_check_tsc;
+	
+	/* Check every 100us to avoid excessive overhead */
+	uint64_t check_interval = stats->tsc_hz / 10000;
+	if (elapsed < check_interval)
+		return;
+	
+	stats->last_check_tsc = now;
+	
+	/* Calculate drops since last check */
+	uint64_t current_dropped = __atomic_load_n(&stats->dropped, __ATOMIC_RELAXED);
+	uint64_t new_drops = current_dropped - stats->last_dropped;
+	stats->last_dropped = current_dropped;
+	
+	/* Sliding window management (2 windows for smoothing) */
+	uint64_t window_elapsed = now - stats->window_start_tsc;
+	uint64_t window_duration = stats->tsc_hz / 1000; /* 1ms windows */
+	
+	if (window_elapsed >= window_duration) {
+		/* Shift window */
+		stats->drop_window[0] = stats->drop_window[1];
+		stats->drop_window[1] = new_drops;
+		stats->window_start_tsc = now;
+	} else {
+		/* Accumulate in current window */
+		stats->drop_window[1] += new_drops;
+	}
+	
+	/* Calculate total drops and TX over both windows */
+	uint64_t total_drops = stats->drop_window[0] + stats->drop_window[1];
+	uint64_t total_tx = __atomic_load_n(&stats->tx, __ATOMIC_RELAXED);
+	
+	/* Backpressure activation/deactivation logic with hysteresis */
+	if (!stats->backpressure_active) {
+		/* Activate backpressure if drop rate exceeds threshold */
+		if (total_tx > 1000) { /* Minimum sample size */
+			double drop_rate = (double)total_drops / (double)total_tx;
+			if (drop_rate > BP_THRESHOLD_RATIO) {
+				stats->backpressure_active = 1;
+				printf("Port %u: Backpressure ACTIVE (drop rate: %.2f%%)\n",
+				       port, drop_rate * 100);
+			}
+		}
+	} else {
+		/* Deactivate backpressure if drop rate falls below recovery threshold */
+		if (total_tx > 1000) {
+			double drop_rate = (double)total_drops / (double)total_tx;
+			if (drop_rate < BP_RECOVERY_RATIO) {
+				stats->backpressure_active = 0;
+				stats->drop_window[0] = 0;
+				stats->drop_window[1] = 0;
+				printf("Port %u: Backpressure RELEASED (drop rate: %.2f%%)\n",
+				       port, drop_rate * 100);
+			}
+		}
+		
+		/* Also recover if no drops for extended period (2+ windows) */
+		if (total_drops == 0 && window_elapsed > window_duration * 2) {
+			stats->backpressure_active = 0;
+			printf("Port %u: Backpressure RELEASED (no drops)\n", port);
+		}
+	}
+}

+				frag_tbl, &death_row, buf, flow_tstamp, ip_hdr,
+				frag_hdr);
+
+			if (buf_out == NULL) {
+				total_empty_cyc += rte_rdtsc_precise() - tstamp;
+				frag_processed++;
+				continue;
+			} else {
+				/*Packet out*/

diff --git a/.mailmap b/.mailmap
index c1bd1e3835..42f198f284 100644
--- a/.mailmap
+++ b/.mailmap
@@ -1167,6 +1167,7 @@ Roman Korynkevych <romanx.korynkevych@intel.com>
 Roman Storozhenko <roman.storozhenko@intel.com>
 Roman Zhukov <roman.zhukov@oktetlabs.ru>

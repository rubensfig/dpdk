commit 61b6874b9224b3128932db76cd18e5eacd5710e5
Author: Zhichao Zeng <zhichaox.zeng@intel.com>
Date:   Wed Jun 14 09:49:46 2023 +0800

    net/iavf: support Rx timestamp offload on AVX512
    
    This patch enables Rx timestamp offload on the AVX512 data path.
    
    It significantly reduces the performance drop when
    RTE_ETH_RX_OFFLOAD_TIMESTAMP is enabled.
    
    Signed-off-by: Zhichao Zeng <zhichaox.zeng@intel.com>
    Tested-by: Yaqi Tang <yaqi.tang@intel.com>
    Acked-by: Qi Zhang <qi.z.zhang@intel.com>

diff --git a/drivers/net/iavf/iavf_rxtx.h b/drivers/net/iavf/iavf_rxtx.h
index 547b68f441..0345a6a51d 100644
--- a/drivers/net/iavf/iavf_rxtx.h
+++ b/drivers/net/iavf/iavf_rxtx.h
@@ -47,7 +47,8 @@

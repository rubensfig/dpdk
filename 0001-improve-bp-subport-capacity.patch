+/* Backpressure activation tracking per port and TC */
+static uint64_t bp_activation_time[RTE_MAX_ETHPORTS][N_TC] = {0};
+static uint64_t bp_deactivation_time[RTE_MAX_ETHPORTS][N_TC] = {0};
+
+#define BP_RECOVERY_TIME_US   1000000  /* 1 second minimum hold time */
+#define BP_DROP_SILENCE_US    500000   /* Deactivate after 500ms with no drops */
+#define BP_CAPACITY_MIN_PCT   10       /* Min capacity: 10% of configured */
+#define BP_CAPACITY_STEP_PCT  5        /* Reduce by 5% per backpressure cycle */
+#define BP_RECOVERY_STEP_PCT  2        /* Recover by 2% per cycle */
+
+/**
+ * update_backpressure_state - Update backpressure activation based on TX drops
+ * 
+ * Monitors NIC TX buffer drops and dynamically adjusts subport capacity
+ * quotas for affected traffic classes. Uses a state machine approach:
+ * - INACTIVE: Monitor for drop rate threshold breach
+ * - ACTIVE: Reduce capacity progressively, hold minimum time
+ * - RECOVERING: Gradually restore capacity
+ */
+static inline void
+update_backpressure_state(uint16_t port, struct rte_sched_port *sched_port)
+{
+	struct rte_port_statistics *stats = &port_statistics[port];
+	uint64_t now = rte_get_tsc_cycles();
+	uint64_t elapsed_cycles = now - stats->last_check_tsc;
+	uint64_t check_interval_cycles = (stats->tsc_hz * BP_CHECK_INTERVAL_US) / 1000000;
+	
+	/* Rate-limit BP checks */
+	if (elapsed_cycles < check_interval_cycles)
+		return;
+	
+	stats->last_check_tsc = now;
+	
+	/* Measure current RX rate for drop ratio calculation */
+	uint64_t rx_now = stats->rx;
+	uint64_t rx_delta = rx_now - stats->last_rx;
+	stats->last_rx = rx_now;
+	
+	/* Per-TC backpressure state machine */
+	for (int tc = 0; tc < N_TC; tc++) {
+		/* Get new drops from NIC buffer */
+		uint64_t dropped = __atomic_load_n(&stats->dropped[tc], __ATOMIC_ACQUIRE);
+		uint64_t last_dropped = stats->last_dropped[tc];
+		uint64_t new_drops = (dropped >= last_dropped) ? (dropped - last_dropped) : dropped;
+		stats->last_dropped[tc] = dropped;
+		
+		/* Calculate drop ratio */
+		double drop_rate = (rx_delta > 0) ? (double)new_drops / (double)rx_delta : 0.0;
+		
+		if (!stats->bp_active[tc]) {
+			/* INACTIVE -> ACTIVE transition */
+			if (drop_rate >= BP_THRESHOLD_RATE) {
+				stats->bp_active[tc] = true;
+				stats->subport_capacity[tc] = 100;
+				bp_activation_time[port][tc] = now;
+				RTE_LOG(INFO, APP, 
+					"Port %u TC %d: BP ACTIVATED (drop_rate=%.4f%%, capacity=100%%)\n",
+					port, tc, drop_rate * 100);
+			}
+		} else {
+			/* ACTIVE: progressively reduce capacity on continued drops */
+			if (new_drops > 0 && stats->subport_capacity[tc] > BP_CAPACITY_MIN_PCT) {
+				stats->subport_capacity[tc] -= BP_CAPACITY_STEP_PCT;
+				if (stats->subport_capacity[tc] < BP_CAPACITY_MIN_PCT)
+					stats->subport_capacity[tc] = BP_CAPACITY_MIN_PCT;
+				RTE_LOG(DEBUG, APP,
+					"Port %u TC %d: Capacity reduced to %u%% (drops=%lu)\n",
+					port, tc, stats->subport_capacity[tc], new_drops);
+			}
+			
+			/* ACTIVE -> INACTIVE transition with hold time */
+			uint64_t held_cycles = now - bp_activation_time[port][tc];
+			uint64_t min_hold_cycles = (stats->tsc_hz * BP_RECOVERY_TIME_US) / 1000000;
+			
+			if (held_cycles >= min_hold_cycles && new_drops == 0) {
+				/* Enter recovery phase */
+				stats->bp_active[tc] = false;
+				bp_deactivation_time[port][tc] = now;
+				RTE_LOG(INFO, APP,
+					"Port %u TC %d: BP DEACTIVATED, entering recovery (held for %lums)\n",
+					port, tc, BP_RECOVERY_TIME_US / 1000);
+			}
+		}
+		
+		/* Gradual capacity recovery during inactive phase */
+		if (!stats->bp_active[tc] && stats->subport_capacity[tc] < 100) {
+			uint64_t recovery_cycles = now - bp_deactivation_time[port][tc];
+			uint64_t recovery_interval = (stats->tsc_hz * BP_CHECK_INTERVAL_US) / 1000000;
+			
+			if (recovery_cycles >= recovery_interval) {
+				stats->subport_capacity[tc] += BP_RECOVERY_STEP_PCT;
+				if (stats->subport_capacity[tc] > 100)
+					stats->subport_capacity[tc] = 100;
+				bp_deactivation_time[port][tc] = now;
+				RTE_LOG(DEBUG, APP,
+					"Port %u TC %d: Capacity recovered to %u%%\n",
+					port, tc, stats->subport_capacity[tc]);
+			}
+		}
+	}
+}

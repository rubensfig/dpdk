+	       cur_fwd_eng->status ? cur_fwd_eng->status : "",
 	       retry_enabled == 0 ? "" : " with retry",
 	       nb_pkt_per_burst);
 
@@ -4906,9 +4908,11 @@ pkt_fwd_config_display(struct fwd_config *cfg)
 	lcoreid_t  lc_id;
